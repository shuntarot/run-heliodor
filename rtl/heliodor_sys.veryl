/// heliodor's SoC (`heliodor_soc_smp`) with N_HARTS harts of the 2-wide core,
/// its memory map, and its DRAM port as plain AXI4 signals. The top for each
/// board puts these on the harness's AXI4 interface, whose ID width depends on
/// N_HARTS.
///
/// The memory map is the Linux boot map of heliodor's test benches: DRAM from
/// 0x8000_0000 (`dut_base`), CLINT, PLIC and UART as IO. DRAM is the 2 GB
/// up to 0xFFFF_FFFF, which the harness's 32-bit AXI4 address reaches, and
/// the core caches all of it but 0x8200_0000 to 0x83FF_FFFF. Those 32 MB are
/// not cached, one dword per access, so the host sees what the core writes
/// there at once: the place for anything the host reads while the program
/// runs, such as the RTT console. Every other address is a hole.
///
/// The Debug Module is reached on its DMI, an APB slave the host drives
/// (`hio cpu`). Its code and data sit at 0x4000 and 0x5000. Its System Bus
/// Access goes through the L2 and recalls lines the L1 owns, so it reads
/// cached DRAM coherently while the core runs, unlike the `dram` window.
module heliodor_sys #(
    param N_HARTS: u32 = 1,
    // The ARID is the SoC's memory slot: two per hart and one for SBA.
    const ID_W: u32 = $clog2(N_HARTS * 2 + 1),
) (
    i_clk   : input clock,
    i_rst   : input reset,
    i_dm_rst: input reset,

    i_dmi_psel   : input  logic    ,
    i_dmi_penable: input  logic    ,
    i_dmi_pwrite : input  logic    ,
    i_dmi_paddr  : input  logic<9> ,
    i_dmi_pwdata : input  logic<32>,
    o_dmi_prdata : output logic<32>,
    o_dmi_pready : output logic    ,

    o_axi_arvalid: output logic      ,
    i_axi_arready: input  logic      ,
    o_axi_arid   : output logic<ID_W>,
    o_axi_araddr : output logic<32>  ,
    o_axi_arlen  : output logic<8>   ,
    o_axi_arsize : output logic<3>   ,
    o_axi_arburst: output logic<2>   ,
    i_axi_rvalid : input  logic      ,
    o_axi_rready : output logic      ,
    i_axi_rid    : input  logic<ID_W>,
    i_axi_rdata  : input  logic<64>  ,
    i_axi_rresp  : input  logic<2>   ,
    i_axi_rlast  : input  logic      ,
    o_axi_awvalid: output logic      ,
    i_axi_awready: input  logic      ,
    o_axi_awid   : output logic<ID_W>,
    o_axi_awaddr : output logic<32>  ,
    o_axi_awlen  : output logic<8>   ,
    o_axi_awsize : output logic<3>   ,
    o_axi_awburst: output logic<2>   ,
    o_axi_wvalid : output logic      ,
    i_axi_wready : input  logic      ,
    o_axi_wdata  : output logic<64>  ,
    o_axi_wstrb  : output logic<8>   ,
    o_axi_wlast  : output logic      ,
    i_axi_bvalid : input  logic      ,
    o_axi_bready : output logic      ,
    i_axi_bid    : input  logic<ID_W>,
    i_axi_bresp  : input  logic<2>   ,
) {
    import heliodor::pma_pkg::*;

    const IO_ATTR      : PmaAttr = PmaAttr'{
        target       : Target::IO    ,
        backed       : 1             ,
        cacheable    : 0             ,
        coherent     : 0             ,
        executable   : 0             ,
        amo          : AmoClass::NONE,
        idempotent   : 0             ,
        io_ordered   : 1             ,
        misaligned_ok: 0             ,
        pte_ok       : 0             ,
        cbo_ok       : 0
    };
    const DRAM_ATTR    : PmaAttr = PmaAttr'{
        target       : Target::DRAM  ,
        backed       : 1             ,
        cacheable    : 1             ,
        coherent     : 1             ,
        executable   : 1             ,
        amo          : AmoClass::FULL,
        idempotent   : 1             ,
        io_ordered   : 0             ,
        misaligned_ok: 1             ,
        pte_ok       : 1             ,
        cbo_ok       : 1
    };
    const NC_ATTR      : PmaAttr = PmaAttr'{
        target       : Target::DRAM  ,
        backed       : 1             ,
        cacheable    : 0             ,
        coherent     : 0             ,
        executable   : 0             ,
        amo          : AmoClass::NONE,
        idempotent   : 1             ,
        io_ordered   : 0             ,
        misaligned_ok: 1             ,
        pte_ok       : 0             ,
        cbo_ok       : 0
    };

    const DM_CODE_ATTR : PmaAttr = PmaAttr'{
        target       : Target::DEBUG ,
        backed       : 1             ,
        cacheable    : 0             ,
        coherent     : 0             ,
        executable   : 1             ,
        amo          : AmoClass::NONE,
        idempotent   : 1             ,
        io_ordered   : 0             ,
        misaligned_ok: 0             ,
        pte_ok       : 0             ,
        cbo_ok       : 0
    };
    const DM_DATA_ATTR : PmaAttr = PmaAttr'{
        target       : Target::DEBUG ,
        backed       : 1             ,
        cacheable    : 0             ,
        coherent     : 0             ,
        executable   : 0             ,
        amo          : AmoClass::NONE,
        idempotent   : 0             ,
        io_ordered   : 1             ,
        misaligned_ok: 0             ,
        pte_ok       : 0             ,
        cbo_ok       : 0
    };

    const MAP_N: u32               = 12;
    const MAP  : PmaRegion [MAP_N] = '{
        PmaRegion'{base: 56'h00_0000_0000_4000, mask: 56'hff_ffff_ffff_f000, attr: DM_CODE_ATTR},
        PmaRegion'{base: 56'h00_0000_0000_5000, mask: 56'hff_ffff_ffff_f000, attr: DM_DATA_ATTR},
        PmaRegion'{base: 56'h00_0000_0200_0000, mask: 56'hff_ffff_ffff_0000, attr: IO_ATTR},
        PmaRegion'{base: 56'h00_0000_0c00_0000, mask: 56'hff_ffff_ffc0_0000, attr: IO_ATTR},
        PmaRegion'{base: 56'h00_0000_1000_0000, mask: 56'hff_ffff_ffff_f000, attr: IO_ATTR},
        PmaRegion'{base: 56'h00_0000_8000_0000, mask: 56'hff_ffff_fe00_0000, attr: DRAM_ATTR},
        PmaRegion'{base: 56'h00_0000_8200_0000, mask: 56'hff_ffff_fe00_0000, attr: NC_ATTR},
        // The rest of the 2 GB, in aligned powers of two: regions must not
        // overlap.
        PmaRegion'{base: 56'h00_0000_8400_0000, mask: 56'hff_ffff_fc00_0000, attr: DRAM_ATTR},
        PmaRegion'{base: 56'h00_0000_8800_0000, mask: 56'hff_ffff_f800_0000, attr: DRAM_ATTR},
        PmaRegion'{base: 56'h00_0000_9000_0000, mask: 56'hff_ffff_f000_0000, attr: DRAM_ATTR},
        PmaRegion'{base: 56'h00_0000_a000_0000, mask: 56'hff_ffff_e000_0000, attr: DRAM_ATTR},
        PmaRegion'{base: 56'h00_0000_c000_0000, mask: 56'hff_ffff_c000_0000, attr: DRAM_ATTR}
    };

    // DRAM is in the low 4 GB: the harness's AXI4 address is 32 bits.
    var araddr: logic<56>;
    var awaddr: logic<56>;
    assign o_axi_araddr = araddr[31:0];
    assign o_axi_awaddr = awaddr[31:0];

    inst u_soc: heliodor::heliodor_soc_smp #(
        N_HARTS    : N_HARTS                       ,
        CORE       : heliodor::soc_pkg::CoreSel::W2,
        PMA_N      : MAP_N                         ,
        PMA_REGIONS: MAP                           ,
    ) (
        clk                  : i_clk            ,
        rst                  : i_rst            ,
        o_imem_addr          : _                ,
        i_imem_rdata         : '{default: 32'd0},
        o_imem_ren           : _                ,
        o_iptw_addr          : _                ,
        o_iptw_req           : _                ,
        i_iptw_rdata         : '{default: 64'd0},
        o_dmem_addr          : _                ,
        o_dmem_wdata         : _                ,
        o_dmem_wen           : _                ,
        o_dmem_ren           : _                ,
        o_dmem_wstrb         : _                ,
        o_dmem_wdata_hi      : _                ,
        o_dmem_wstrb_hi      : _                ,
        o_axi_arvalid        : o_axi_arvalid    ,
        i_axi_arready        : i_axi_arready    ,
        o_axi_arid           : o_axi_arid       ,
        o_axi_araddr         : araddr           ,
        o_axi_arlen          : o_axi_arlen      ,
        o_axi_arsize         : o_axi_arsize     ,
        o_axi_arburst        : o_axi_arburst    ,
        o_axi_arlock         : _                ,
        o_axi_arcache        : _                ,
        o_axi_arprot         : _                ,
        o_axi_arqos          : _                ,
        i_axi_rvalid         : i_axi_rvalid     ,
        o_axi_rready         : o_axi_rready     ,
        i_axi_rid            : i_axi_rid        ,
        i_axi_rdata          : i_axi_rdata      ,
        i_axi_rresp          : i_axi_rresp      ,
        i_axi_rlast          : i_axi_rlast      ,
        o_axi_awvalid        : o_axi_awvalid    ,
        i_axi_awready        : i_axi_awready    ,
        o_axi_awid           : o_axi_awid       ,
        o_axi_awaddr         : awaddr           ,
        o_axi_awlen          : o_axi_awlen      ,
        o_axi_awsize         : o_axi_awsize     ,
        o_axi_awburst        : o_axi_awburst    ,
        o_axi_awlock         : _                ,
        o_axi_awcache        : _                ,
        o_axi_awprot         : _                ,
        o_axi_awqos          : _                ,
        o_axi_wvalid         : o_axi_wvalid     ,
        i_axi_wready         : i_axi_wready     ,
        o_axi_wdata          : o_axi_wdata      ,
        o_axi_wstrb          : o_axi_wstrb      ,
        o_axi_wlast          : o_axi_wlast      ,
        i_axi_bvalid         : i_axi_bvalid     ,
        o_axi_bready         : o_axi_bready     ,
        i_axi_bid            : i_axi_bid        ,
        i_axi_bresp          : i_axi_bresp      ,
        o_axi_err            : _                ,
        o_uart_tx_valid      : _                ,
        o_uart_tx_data       : _                ,
        o_dbg_load_viol_cnt  : _                ,
        o_dbg_load_replay_cnt: _                ,
        o_dbg_inv_viol_cnt   : _                ,
        o_dbg_mshr_pois_cnt  : _                ,
        o_dbg_viol_exact_cnt : _                ,
        o_dbg_viol_pgx_cnt   : _                ,
        o_dbg_st_resolve_cnt : _                ,
        o_dbg_viol_store_cnt : _                ,
        o_dbg_viol_self_cnt  : _                ,
        o_dbg_lw_cause       : _                ,
        o_dbg_load_wait_cnt  : _                ,
        o_dbg_rob_commit_cnt : _                ,
        o_dbg_r3             : _                ,
        o_dbg_pc             : _                ,
        o_dbg_retire_v       : _                ,
        o_dbg_trap_fire      : _                ,
        o_dbg_trap_cause     : _                ,
        o_dbg_trap_pc        : _                ,
        o_dbg_stval          : _                ,
        o_dbg_satp           : _                ,
        o_dbg_stvec          : _                ,
        o_dbg_mtvec          : _                ,
        o_dbg_trap_to_s      : _                ,
        o_dbg_sp             : _                ,
        o_dbg_tp             : _                ,
        o_dbg_dmem_fault     : _                ,
        o_dbg_dtlb_hit       : _                ,
        o_dbg_dtlb_ppn       : _                ,
        o_dbg_dtlb_perm      : _                ,
        o_dbg_dptw_addr      : _                ,
        o_dbg_dpte           : _                ,
        o_dbg_dmem_vaddr     : _                ,
        o_dbg_redirect_fire  : _                ,
        o_dbg_fl_push_en     : _                ,
        o_dbg_commit_rd      : _                ,
        o_dbg_commit_pdst    : _                ,
        o_dbg_agu_rs1_arch   : _                ,
        o_dbg_agu_rs1_pdst   : _                ,
        o_dbg_agu_rs1_archval: _                ,
        o_dbg_agu_is_load    : _                ,
        o_dbg_agu_addr       : _                ,
        o_dbg_lfault_inj     : _                ,
        o_dbg_walk_vaddr     : _                ,
        o_dbg_walk_v         : _                ,
        o_dbg_walk_rob       : _                ,
        o_dbg_orphan_walk    : _                ,
        o_dbg_walk_phys      : _                ,
        o_dbg_walk_start     : _                ,
        o_dbg_dmem_idle      : _                ,
        o_dbg_dlk_seen       : _                ,
        o_dbg_dlk_genuine    : _                ,
        o_dbg_dlk_inj        : _                ,
        o_dbg_dlk_stval      : _                ,
        o_dbg_dlk_pc         : _                ,
        o_dbg_dlk_walkpc     : _                ,
        o_dbg_retire_pc      : _                ,
        o_dbg_retire_rdv     : _                ,
        o_dbg_retire_rd      : _                ,
        o_dbg_retire_dat     : _                ,
        o_retire             : _                ,
        o_irq_evt            : _                ,
        o_core_chk           : _                ,
        o_core_perf          : _                ,
        o_mc_perf            : _                ,
        o_io_obs             : _                ,
        i_dm_rst             : i_dm_rst         ,
        i_dm_psel            : i_dmi_psel       ,
        i_dm_penable         : i_dmi_penable    ,
        i_dm_pwrite          : i_dmi_pwrite     ,
        i_dm_paddr           : i_dmi_paddr      ,
        i_dm_pwdata          : i_dmi_pwdata     ,
        i_dm_pstrb           : 4'hf             ,
        i_dm_pprot           : 3'd0             ,
        o_dm_pready          : o_dmi_pready     ,
        o_dm_prdata          : o_dmi_prdata     ,
        o_dm_pslverr         : _                ,
        o_dm_obs             : _                ,
    );
}
