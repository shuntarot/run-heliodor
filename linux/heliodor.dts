/* heliodor's core in the harness: one hart, the CLINT, and memory. No UART
 * and no PLIC: the console is the SBI one, which the firmware puts on RTT.
 *
 * Memory is the 31 MB from the kernel (0x8000_0000) up to the firmware
 * (0x81f0_0000). The cached part of DRAM ends 1 MB above it. */
/dts-v1/;

/ {
	#address-cells = <2>;
	#size-cells = <2>;
	compatible = "heliodor,rv64";
	model = "heliodor on veryl-harness";

	chosen {
		bootargs = "earlycon=sbi no4lvl nokaslr";
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		/* mtime counts at a tenth of the 20 MHz core clock. */
		timebase-frequency = <2000000>;

		cpu@0 {
			device_type = "cpu";
			compatible = "riscv";
			reg = <0>;
			riscv,isa = "rv64imafdc";
			mmu-type = "riscv,sv39";
			status = "okay";

			cpu0_intc: interrupt-controller {
				#interrupt-cells = <1>;
				compatible = "riscv,cpu-intc";
				interrupt-controller;
			};
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x1f00000>;
	};

	soc {
		#address-cells = <2>;
		#size-cells = <2>;
		compatible = "simple-bus";
		ranges;

		clint@2000000 {
			compatible = "riscv,clint0";
			reg = <0x0 0x2000000 0x0 0x10000>;
			interrupts-extended = <&cpu0_intc 3>, <&cpu0_intc 7>;
		};
	};
};
