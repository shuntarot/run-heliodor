/* heliodor's core in the harness: one hart, the CLINT, and memory. No UART
 * and no PLIC: the console is the SBI one, which the firmware puts on RTT.
 *
 * Memory starts at the kernel (0x8020_0000); below it is the firmware. It
 * ends at 0x8200_0000, where the cached part of DRAM ends. */
/dts-v1/;

/ {
	#address-cells = <2>;
	#size-cells = <2>;
	compatible = "heliodor,rv64";
	model = "heliodor on veryl-harness";

	chosen {
		/* no4lvl: the core has Sv39 only, but its satp takes any mode, so
		 * Linux would find Sv57 and Sv48 there. */
		bootargs = "console=hvc0 earlycon=sbi no4lvl";
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		/* mtime counts at a tenth of the 20 MHz core clock. */
		timebase-frequency = <2000000>;

		cpu@0 {
			device_type = "cpu";
			compatible = "riscv";
			reg = <0>;
			riscv,isa = "rv64imafdc";
			/* Linux reads these; it reads riscv,isa only with
			 * RISCV_ISA_FALLBACK, which tinyconfig leaves out. */
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c",
				"zicsr", "zifencei", "zicntr";
			mmu-type = "riscv,sv39";
			status = "okay";

			cpu0_intc: interrupt-controller {
				#interrupt-cells = <1>;
				compatible = "riscv,cpu-intc";
				interrupt-controller;
			};
		};
	};

	memory@80200000 {
		device_type = "memory";
		reg = <0x0 0x80200000 0x0 0x1e00000>;
	};

	soc {
		#address-cells = <2>;
		#size-cells = <2>;
		compatible = "simple-bus";
		ranges;

		clint@2000000 {
			compatible = "riscv,clint0";
			reg = <0x0 0x2000000 0x0 0x10000>;
			interrupts-extended = <&cpu0_intc 3>, <&cpu0_intc 7>;
		};
	};
};
