# Linux for heliodor in the harness, on top of `make tinyconfig`.
# One hart, Sv39, no devices but the CLINT timer and the SBI console.
CONFIG_ARCH_RV64I=y
CONFIG_64BIT=y
CONFIG_MMU=y
CONFIG_SMP=n
CONFIG_RISCV_ISA_C=y
CONFIG_FPU=y
CONFIG_NONPORTABLE=y
CONFIG_RISCV_SBI_V01=y
CONFIG_HZ_100=y

# The console: SBI calls, which the firmware puts on RTT
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_HVC_RISCV_SBI=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y

# The root file system is the initramfs built in
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_COMPRESSION_NONE=y
CONFIG_RD_GZIP=n
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# What a static busybox with glibc uses
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_POSIX_TIMERS=y
CONFIG_FILE_LOCKING=y
CONFIG_UNIX98_PTYS=y
